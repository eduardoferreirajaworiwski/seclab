# Build context for the gateway/cli/sensor_chimera Dockerfiles is the
# monorepo root - none of them `COPY . .`, but without this file the whole
# tree (including .env, .venv, node_modules, seclab.db) is still uploaded to
# the Docker daemon on every build.
.git
.env
.env.local
*.db
.venv
**/.venv
**/__pycache__
**/*.egg-info
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
data/monitor-captures

apps/web/node_modules
apps/web/.next
