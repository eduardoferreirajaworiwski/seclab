# Copy to .env before running `docker compose up`.

# Required: HMAC pepper for API-key hashing (seclab.security.keys). Generate
# a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECLAB_API_KEY_PEPPER=change-me-to-a-random-secret

# Optional: honeypot alerting (packages/modules/sensor_chimera).
SECLAB_DISCORD_WEBHOOK_URL=
