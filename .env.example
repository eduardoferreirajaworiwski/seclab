# Copy to .env before running `docker compose up` or a local uvicorn/CLI run.

# Required: HMAC pepper for API-key hashing (seclab.security.keys). Generate
# a real one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECLAB_API_KEY_PEPPER=change-me-to-a-random-secret

# Optional: database location. Defaults to a local sqlite file.
SECLAB_DATABASE_URL=sqlite:///./seclab.db

# Optional: comma-separated list of origins the gateway's CORS policy
# allows. Defaults to the local dashboard dev server only.
SECLAB_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Optional: default per-IP rate limit applied to every gateway route.
SECLAB_RATE_LIMIT_DEFAULT=60/minute

# Optional: enables AI-assisted analyst summaries in `phantom` (OpenAI) -
# falls back to a deterministic summary when unset.
SECLAB_OPENAI_API_KEY=
SECLAB_OPENAI_MODEL=gpt-4.1-mini

# Optional: ThreatLens weekly digest narrative (packages/modules/threatlens).
# Get a key at https://aistudio.google.com/apikey
SECLAB_GEMINI_API_KEY=

# Optional: osint_breach breach/leak watcher live lookups (Have I Been
# Pwned API v3, packages/modules/osint_breach) - falls back to the
# offline fixture set when unset. Get a key at
# https://haveibeenpwned.com/API/Key
SECLAB_HIBP_API_KEY=

# Optional: honeypot alerting (packages/modules/sensor_chimera) and the
# shared event bus's DiscordSink.
SECLAB_DISCORD_WEBHOOK_URL=

# Optional: monitor module - keywords to watch on the CertStream feed.
SECLAB_MONITOR_KEYWORDS=["microsoft","google","binance","netflix"]
SECLAB_MONITOR_CAPTURE_ENABLED=true
